{
  "id": "item-configurator",
  "title": "Item Configurator",
  "description": "Configure a dnd5e item (details, activities, active effects) from its description, with a preview and optional local AI.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Rydka"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "requires": [
      {
        "id": "dnd5e-text-parser",
        "type": "module",
        "compatibility": {
          "minimum": "1.0.0",
          "verified": "1.0.0"
        }
      }
    ],
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0",
          "verified": "6.0.6"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/item-configurator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "url": "https://github.com/rydka/item-configurator",
  "manifest": "https://github.com/rydka/item-configurator/releases/latest/download/module.json",
  "download": "https://github.com/rydka/item-configurator/releases/latest/download/module.zip",
  "bugs": "https://github.com/rydka/item-configurator/issues"
}
