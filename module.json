{
  "id": "item-configurator",
  "title": "Item Configurator",
  "description": "Configure a dnd5e item (details, activities, active effects) from its description, with a preview and optional local AI.",
  "version": "0.1.0-v13",
  "authors": [
    {
      "name": "Rydka"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "requires": [
      {
        "id": "dnd5e-text-parser",
        "type": "module",
        "compatibility": {
          "minimum": "1.1.0-v13",
          "verified": "1.1.0-v13"
        },
        "manifest": "https://raw.githubusercontent.com/rydka/dnd5e-text-parser/v13/module.json"
      }
    ],
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "5.3.3",
          "maximum": "5.99"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/item-configurator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "url": "https://github.com/rydka/item-configurator",
  "manifest": "https://raw.githubusercontent.com/rydka/item-configurator/v13/module.json",
  "download": "https://github.com/rydka/item-configurator/releases/download/v0.1.0-v13/module.zip",
  "bugs": "https://github.com/rydka/item-configurator/issues"
}
