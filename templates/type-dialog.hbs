<div class="item-configurator-body">
<p class="hint">{{localize "item-configurator.TypeDialog.Hint"}}</p>
<div class="form-group">
  <label>{{localize "item-configurator.TypeDialog.Type"}}</label>
  <div class="form-fields">
    <select name="type">
      {{#each types}}<option value="{{type}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
</div>
<div class="form-group" {{#unless subtypes.length}}hidden{{/unless}}>
  <label>{{localize "item-configurator.TypeDialog.Subtype"}}</label>
  <div class="form-fields">
    <select name="subtype" {{#unless subtypes.length}}disabled{{/unless}}>
      {{#each subtypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
</div>
{{#if aiEnabled}}<p class="notes"><i class="fa-solid fa-robot"></i> {{localize "item-configurator.TypeDialog.AiOn"}}</p>{{/if}}
<p class="busy-note"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "item-configurator.TypeDialog.Analyzing"}}</p>
<footer class="form-footer">
  <button type="submit" class="item-configurator-analyze"><i class="fa-solid fa-magnifying-glass"></i> {{localize "item-configurator.TypeDialog.Analyze"}}</button>
  <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> {{localize "item-configurator.Cancel"}}</button>
</footer>
</div>
